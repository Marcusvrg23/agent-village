{
  "name": "codex-ops-room",
  "version": "1.0.0",
  "private": true,
  "description": "Agent Village: vila local dos seus agentes Claude Code e Codex (e o Codex Ops Room original).",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "node server.js",
    "ops-room": "node scripts/ops-room.mjs",
